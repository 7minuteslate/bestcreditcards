
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Mariela Murguia – Links</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  color-scheme: light dark;
  --bg:#EDF1F7; --card:#FFFFFF; --ink:#14213D; --muted:#5B6783; --accent:#2F5BEA; --on-accent:#FFFFFF; --line:#D5DCEA;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    color-scheme:dark;
    --bg:#0F1522; --card:#19213A; --ink:#EEF1FA; --muted:#9AA6C4; --accent:#7C9BFF; --on-accent:#0F1522; --line:#2A3558;
  }
}
:root[data-theme="dark"]{
  color-scheme:dark;
  --bg:#0F1522; --card:#19213A; --ink:#EEF1FA; --muted:#9AA6C4; --accent:#7C9BFF; --on-accent:#0F1522; --line:#2A3558;
}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"DM Sans",system-ui,-apple-system,"Segoe UI",sans-serif;line-height:1.45;min-height:100vh}
main{max-width:460px;margin:0 auto;padding:40px 20px 32px}
.avatar{width:84px;height:84px;border-radius:50%;background:var(--accent);color:var(--on-accent);display:grid;place-items:center;font-size:34px;font-weight:700;margin:0 auto 14px}
h1{font-size:26px;line-height:1.15;margin:0;text-align:center;font-weight:700;letter-spacing:-.01em}
.bio{text-align:center;color:var(--muted);margin:8px 0 28px}
ul{list-style:none;margin:0;padding:0;display:grid;gap:12px}
a.link{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px 18px;border-radius:14px;background:var(--card);color:var(--ink);text-decoration:none;border:1px solid var(--line);font-weight:500;transition:transform .15s,border-color .15s}
a.link:hover{border-color:var(--accent);transform:translateY(-1px)}
a.link:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
a.link.featured{background:var(--accent);color:var(--on-accent);border-color:var(--accent);padding:20px 18px;font-weight:700;font-size:18px}
.tag{font-size:13px;font-weight:500;color:var(--muted);white-space:nowrap}
.featured .tag{color:var(--on-accent);opacity:.85}
.note{margin:28px 0 0;font-size:13px;color:var(--muted);text-align:center}
@media (prefers-reduced-motion:reduce){a.link{transition:none}}
</style>
</head>
<body>
<main>
  <div class="avatar" aria-hidden="true">M</div>
  <h1>Mariela Murguia</h1>
  <p class="bio">Things I use to save money, and other things</p>
  <ul id="links"></ul>
  <p class="note">Some links are affiliate links. I may earn a small commission if you buy, at no extra cost to you.</p>
</main>
<script>
// Edit this list: title, url, and an optional tag (like a discount code). The first link is shown larger.
var LINKS = [
  { title: "My top pick this month", url: "https://example.com/affiliate-1", tag: "Featured" },
  { title: "Skincare routine", url: "https://example.com/affiliate-2", tag: "Code: YOURNAME10" },
  { title: "Home office setup", url: "https://example.com/affiliate-3" },
  { title: "Workout gear", url: "https://example.com/affiliate-4", tag: "15% off" },
  { title: "Kitchen favorites", url: "https://example.com/affiliate-5" }
];
var list = document.getElementById("links");
LINKS.forEach(function(l, i){
  var li = document.createElement("li");
  var a = document.createElement("a");
  a.className = "link" + (i === 0 ? " featured" : "");
  a.href = l.url;
  a.target = "_blank";
  a.rel = "noopener noreferrer sponsored";
  var t = document.createElement("span");
  t.textContent = l.title;
  a.appendChild(t);
  if (l.tag) {
    var g = document.createElement("span");
    g.className = "tag";
    g.textContent = l.tag;
    a.appendChild(g);
  }
  li.appendChild(a);
  list.appendChild(li);
});
</script>
</body>
</html>
